# GEMINI_API_KEY: Required for Gemini AI API calls.
# Backend-only secret. Set this in your hosting provider (Render), never in VITE_* variables.
GEMINI_API_KEY="paste_your_gemini_api_key_here"

# Optional: set this only when the AI server is hosted on a different domain.
# For local development, leave blank so requests go to the local Express server.
VITE_AI_API_BASE_URL=""

# Backend-only: comma-separated website origins allowed to call the AI server.
# Example: https://kevinantonakhil-coder.github.io
AI_ALLOWED_ORIGINS=""

# Public URL where the backend is hosted (if your deployment needs it).
APP_URL="https://your-backend.example.com"

# VITE_CARTO_API_KEY: Free CARTO basemap API key for watermark-free Voyager tiles.
VITE_CARTO_API_KEY=your_carto_api_key_here
